// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../src/generated"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  gender       Gender
  passwordHash String
  status       UserStatus @default(PENDING_VERIFICATION)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  recentSearches   RecentSearch[]
}

model Doctor {
  id          String      @id @default(uuid())
  name        String
  specialtyId String
  gender      Gender
  title       DoctorTitle
  location    String
  price       Float
  rating      Float       @default(0)
  viewsCount  Int         @default(0)
  createdAt   DateTime    @default(now())

  @@index([specialtyId, rating])
  @@index([location, price])
  @@index([name])
}

model RecentSearch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  term      String   // الاسم اللي ظهر وضغط عليه (اسم دكتور أو اسم تخصص)
  type      String   // نوع النتيجة: 'doctor' أو 'specialty'
  targetId  String   // الـ ID بتاع الدكتور أو التخصص
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)]) // Index مركب لضمان جلب أخر 5 بسرعة طلقة
}

enum DoctorTitle {
  PROFESSOR
  CONSULTANT
  SPECIALIST
}

enum Gender {
  MALE
  FEMALE
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  BANNED
}

model WelcomeConfig {
  id                 Int      @id @default(autoincrement())
  logoUrl            String
  supportPhone       String
  googleAuthEnabled  Boolean  @default(true)
  
  banners            Banner[]
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Banner {
  id              Int           @id @default(autoincrement())
  imageUrl        String
  title           String
  description     String
  
  configId        Int
  welcomeConfig   WelcomeConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
